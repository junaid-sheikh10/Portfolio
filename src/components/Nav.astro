---
import { profile } from '../data/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav">
  <div class="container inner">
    <a href="#top" class="brand">{profile.name}</a>
    <nav>
      {links.map((l) => <a href={l.href} class="link">{l.label}</a>)}
      <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <span class="sun">☀</span><span class="moon">☾</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .brand {
    font-weight: 800;
    color: var(--text);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .link {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .link:hover {
    color: var(--text);
    text-decoration: none;
  }
  button {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    width: 34px;
    height: 34px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1rem;
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
  @media (max-width: 640px) {
    .link {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
