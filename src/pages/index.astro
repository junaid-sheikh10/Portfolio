---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { profile, socials, about, skills, projects, experience } from '../data/site';

const year = new Date().getFullYear();
---

<Base>
  <Nav />

  <main id="top">
    <!-- Hero -->
    <div class="hero container">
      <p class="hello">Hi, I'm</p>
      <h1>{profile.name}</h1>
      <p class="role">{profile.title}</p>
      <p class="tagline">{profile.tagline}</p>
      <div class="actions">
        <a class="btn" href="#projects">View my work</a>
        <a class="btn ghost" href="#contact">Get in touch</a>
        {profile.resumeUrl && <a class="btn ghost" href={profile.resumeUrl}>Résumé</a>}
      </div>
    </div>

    <!-- About -->
    <section id="about">
      <div class="container about">
        <div>
          <p class="section-title">About</p>
          <h2>A little about me</h2>
          {about.map((p) => <p class="muted">{p}</p>)}
        </div>
        <div class="skills">
          {
            skills.map((s) => (
              <div class="skill-group">
                <h3>{s.group}</h3>
                <div class="tags">
                  {s.items.map((i) => <span class="tag">{i}</span>)}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="container">
        <p class="section-title">Projects</p>
        <h2>Things I've built</h2>
        <div class="grid">
          {
            projects.map((p) => (
              <article class="card project">
                <h3>{p.title}</h3>
                <p class="muted">{p.description}</p>
                <div class="tags">
                  {p.tech.map((t) => <span class="tag">{t}</span>)}
                </div>
                <div class="links">
                  {p.github && <a href={p.github} target="_blank" rel="noopener">Code ↗</a>}
                  {p.live && <a href={p.live} target="_blank" rel="noopener">Live demo ↗</a>}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="container">
        <p class="section-title">Experience</p>
        <h2>Work & education</h2>
        <ol class="timeline">
          {
            experience.map((e) => (
              <li>
                <div class="period">{e.period}</div>
                <div>
                  <h3>{e.role}</h3>
                  <p class="org">{e.org}</p>
                  <p class="muted">{e.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact">
      <div class="container contact">
        <p class="section-title">Contact</p>
        <h2>Let's work together</h2>
        <p class="muted">
          I'm open to new opportunities and collaborations. The quickest way to reach me is email.
        </p>
        <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="socials">
          {socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}
        </div>
      </div>
    </section>
  </main>

  <footer class="container">
    <p>© {year} {profile.name} · Built with Astro</p>
  </footer>
</Base>

<style>
  .muted {
    color: var(--muted);
  }
  h3 {
    margin: 0 0 6px;
    font-size: 1.1rem;
  }

  /* Hero */
  .hero {
    padding-top: 112px;
    padding-bottom: 96px;
  }
  .hello {
    color: var(--accent);
    font-weight: 600;
    margin: 0;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
    margin: 8px 0;
    letter-spacing: -0.03em;
  }
  .role {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--muted);
    font-weight: 600;
    margin: 0 0 20px;
  }
  .tagline {
    max-width: 600px;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
  }
  .skills {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .skill-group h3 {
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Projects */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .project:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .project p {
    margin: 0;
    flex: 1;
  }
  .links {
    display: flex;
    gap: 16px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 28px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
  }
  .period {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    padding-top: 2px;
  }
  .org {
    margin: 0;
    font-weight: 500;
  }
  .timeline .muted {
    margin: 4px 0 0;
  }

  /* Contact */
  .contact {
    text-align: center;
    max-width: 640px;
  }
  .contact h2 {
    margin-bottom: 12px;
  }
  .contact .muted {
    margin-bottom: 28px;
  }
  .socials {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 24px;
    font-weight: 600;
  }

  footer {
    padding: 32px 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .hero {
      padding-top: 72px;
      padding-bottom: 64px;
    }
    section {
      padding: 56px 0;
    }
  }
</style>
